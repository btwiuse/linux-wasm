From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Linux-Wasm <linux-wasm@users.noreply.github.com>
Date: Mon, 26 May 2026 00:00:00 +0000
Subject: [PATCH] wasm: hvc: Add terminal window size support

Add wasm_driver_hvc_get_winsize() host import to retrieve the terminal
dimensions from the JavaScript host (Xterm.js). The window size is
checked during each get_chars poll cycle and hvc_resize() is called
when changes are detected.

This enables `stty size` and applications that use TIOCGWINSZ to
correctly report terminal dimensions in the Wasm environment.

The host function returns a packed int32: (rows << 16) | cols.

Signed-off-by: Linux-Wasm <linux-wasm@users.noreply.github.com>
---
 arch/wasm/kernel/hvc_wasm.c | 62 +++++++++++++++++++++++++++++++++++++
 arch/wasm/kernel/Makefile   |  1 +
 2 files changed, 63 insertions(+)
 create mode 100644 arch/wasm/kernel/hvc_wasm.c

diff --git a/arch/wasm/kernel/hvc_wasm.c b/arch/wasm/kernel/hvc_wasm.c
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/arch/wasm/kernel/hvc_wasm.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include "../../../drivers/tty/hvc/hvc_console.h"
+
+extern int wasm_driver_hvc_put(const char *buf, int count);
+extern int wasm_driver_hvc_get(char *buf, int count);
+extern int wasm_driver_hvc_get_winsize(void);
+
+static struct hvc_struct *hvc_wasm_hp;
+
+static ssize_t hvc_wasm_put_chars(uint32_t vtermno, const u8 *buf, size_t count)
+{
+	return wasm_driver_hvc_put((const char *)buf, count);
+}
+
+static ssize_t hvc_wasm_get_chars(uint32_t vtermno, u8 *buf, size_t count)
+{
+	int ret = wasm_driver_hvc_get((char *)buf, count);
+
+	/* Check for window size change on each poll */
+	if (hvc_wasm_hp) {
+		int packed = wasm_driver_hvc_get_winsize();
+		if (packed > 0) {
+			struct winsize ws = {
+				.ws_row = (packed >> 16) & 0xFFFF,
+				.ws_col = packed & 0xFFFF,
+			};
+			if (ws.ws_row != hvc_wasm_hp->ws.ws_row ||
+			    ws.ws_col != hvc_wasm_hp->ws.ws_col) {
+				hvc_resize(hvc_wasm_hp, ws);
+			}
+		}
+	}
+
+	return ret;
+}
+
+static const struct hv_ops hvc_wasm_ops = {
+	.get_chars = hvc_wasm_get_chars,
+	.put_chars = hvc_wasm_put_chars,
+};
+
+static int __init hvc_wasm_init(void)
+{
+	struct hvc_struct *hp;
+	int packed;
+
+	hp = hvc_alloc(0, 0, &hvc_wasm_ops, PAGE_SIZE);
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+
+	hvc_wasm_hp = hp;
+
+	/* Set initial window size */
+	packed = wasm_driver_hvc_get_winsize();
+	if (packed > 0) {
+		struct winsize ws = {
+			.ws_row = (packed >> 16) & 0xFFFF,
+			.ws_col = packed & 0xFFFF,
+		};
+		hvc_resize(hp, ws);
+	}
+
+	return 0;
+}
+device_initcall(hvc_wasm_init);
+
+static int __init hvc_wasm_console_init(void)
+{
+	hvc_instantiate(0, 0, &hvc_wasm_ops);
+	return 0;
+}
+console_initcall(hvc_wasm_console_init);
diff --git a/arch/wasm/kernel/Makefile b/arch/wasm/kernel/Makefile
index 787a7c00e..000000000 100644
--- a/arch/wasm/kernel/Makefile
+++ b/arch/wasm/kernel/Makefile
@@ -19,3 +19,4 @@ obj-y += traps.o
 
 ifndef CONFIG_64BIT
 obj-y += sys_wasm32.o
 endif
+obj-$(CONFIG_HVC_DRIVER) += hvc_wasm.o
-- 
2.25.1
